# Copy to .env and enter your own credentials, never commit .env to Git.
APP_ENV=production
APP_URL=https://your-domain.example
APP_DEBUG=false
DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_hostinger_db_name
DB_USER=your_hostinger_db_user
DB_PASSWORD=replace_with_private_db_password
MAIL_FROM=no-reply@your-domain.example
